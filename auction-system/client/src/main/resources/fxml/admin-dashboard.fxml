<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AdminDashboardController"
            styleClass="app-shell"
            stylesheets="@../css/main.css">

    <!-- ── TOP NAV ──────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16"
              styleClass="top-nav">

            <Label text="⬡ AUCTION" styleClass="nav-brand"/>

            <Separator orientation="VERTICAL"
                       style="-fx-opacity: 0.2; -fx-padding: 0 4;"/>

            <Label text="ADMIN CONSOLE"
                   styleClass="label-secondary"
                   style="-fx-font-size: 12px; -fx-letter-spacing: 0.06em;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblAdminName"
                   text="Admin"
                   styleClass="role-badge"
                   style="-fx-text-fill: #F15E6C; -fx-border-color: #F15E6C;
                          -fx-background-color: rgba(241,94,108,0.10);"/>

            <Button text="Đăng xuất"
                    onAction="#handleLogout"
                    styleClass="button, btn-secondary"
                    style="-fx-padding: 8 18; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <!-- ── CENTER: TabPane ──────────────────────────────── -->
    <center>
        <TabPane fx:id="tabPane"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #121212;">

            <!-- TAB 1: USER MANAGEMENT ──────────────────── -->
            <Tab text="Người dùng">
                <VBox spacing="14" style="-fx-padding: 20; -fx-background-color: #121212;">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="QUẢN LÝ TÀI KHOẢN"
                               styleClass="sidebar-section-label"
                               style="-fx-padding: 0; -fx-font-size: 11px;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtSearchUser"
                                   promptText="Tìm username / email..."
                                   prefWidth="260"
                                   style="-fx-background-radius: 500; -fx-border-radius: 500; -fx-padding: 8 16;"/>
                        <Button text="↻ Làm mới" onAction="#refreshUsers"
                                styleClass="button, btn-primary"
                                style="-fx-padding: 8 18; -fx-font-size: 12px;"/>
                    </HBox>

                    <TableView fx:id="tblUsers" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #181818;
                                      -fx-background-radius: 10;
                                      -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colUserId"   text="ID"         prefWidth="55"/>
                            <TableColumn fx:id="colUsername" text="USERNAME"    prefWidth="160"/>
                            <TableColumn fx:id="colEmail"    text="EMAIL"       prefWidth="210"/>
                            <TableColumn fx:id="colRole"     text="VAI TRÒ"     prefWidth="100"/>
                            <TableColumn fx:id="colBalance"  text="SỐ DƯ"       prefWidth="130"/>
                            <TableColumn fx:id="colStatus"   text="TRẠNG THÁI"  prefWidth="110"/>
                            <TableColumn fx:id="colActions"  text="HÀNH ĐỘNG"   prefWidth="160"/>
                        </columns>
                        <placeholder>
                            <Label text="Không có dữ liệu" styleClass="label-muted"
                                   style="-fx-font-size: 13px;"/>
                        </placeholder>
                    </TableView>

                </VBox>
            </Tab>

            <!-- TAB 2: AUCTION MANAGEMENT ───────────────── -->
            <Tab text="Đấu giá">
                <VBox spacing="14" style="-fx-padding: 20; -fx-background-color: #121212;">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="QUẢN LÝ PHIÊN ĐẤU GIÁ"
                               styleClass="sidebar-section-label"
                               style="-fx-padding: 0; -fx-font-size: 11px;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="↻ Làm mới" onAction="#refreshAuctions"
                                styleClass="button, btn-primary"
                                style="-fx-padding: 8 18; -fx-font-size: 12px;"/>
                    </HBox>

                    <TableView fx:id="tblAuctions" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #181818;
                                      -fx-background-radius: 10;
                                      -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colAucId"      text="ID"          prefWidth="55"/>
                            <TableColumn fx:id="colAucName"    text="SẢN PHẨM"    prefWidth="260"/>
                            <TableColumn fx:id="colAucSeller"  text="NGƯỜI BÁN"   prefWidth="130"/>
                            <TableColumn fx:id="colAucPrice"   text="GIÁ HIỆN TẠI" prefWidth="140"/>
                            <TableColumn fx:id="colAucStatus"  text="TRẠNG THÁI"  prefWidth="120"/>
                            <TableColumn fx:id="colAucEndTime" text="KẾT THÚC"    prefWidth="140"/>
                            <TableColumn fx:id="colAucActions" text="HÀNH ĐỘNG"   prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="Không có dữ liệu" styleClass="label-muted"
                                   style="-fx-font-size: 13px;"/>
                        </placeholder>
                    </TableView>

                </VBox>
            </Tab>

            <!-- TAB 3: SYSTEM STATS ─────────────────────── -->
            <Tab text="Thống kê">
                <VBox spacing="28" style="-fx-padding: 36; -fx-background-color: #121212;">

                    <Label text="TỔNG QUAN HỆ THỐNG"
                           styleClass="sidebar-section-label"
                           style="-fx-padding: 0 0 4 0; -fx-font-size: 11px;"/>

                    <!-- Stats row -->
                    <HBox spacing="20" alignment="CENTER_LEFT">

                        <!-- Total Users -->
                        <VBox spacing="10" alignment="CENTER" styleClass="stat-card">
                            <Label text="TỔNG NGƯỜI DÙNG" styleClass="stat-label"
                                   style="-fx-letter-spacing: 0.06em;"/>
                            <Label fx:id="lblTotalUsers" text="0"
                                   styleClass="stat-number, stat-number-blue"/>
                        </VBox>

                        <!-- Running Auctions -->
                        <VBox spacing="10" alignment="CENTER" styleClass="stat-card">
                            <Label text="ĐANG DIỄN RA" styleClass="stat-label"
                                   style="-fx-letter-spacing: 0.06em;"/>
                            <Label fx:id="lblRunningAuctions" text="0"
                                   styleClass="stat-number, stat-number-green"/>
                        </VBox>

                        <!-- Finished -->
                        <VBox spacing="10" alignment="CENTER" styleClass="stat-card">
                            <Label text="GIAO DỊCH THÀNH CÔNG" styleClass="stat-label"
                                   style="-fx-letter-spacing: 0.06em;"/>
                            <Label fx:id="lblFinishedAuctions" text="0"
                                   styleClass="stat-number, stat-number-orange"/>
                        </VBox>

                    </HBox>

                    <!-- Refresh all -->
                    <HBox>
                        <Button text="↻  Làm mới tất cả" onAction="#refreshAll"
                                styleClass="button, btn-primary"
                                style="-fx-padding: 10 24;"/>
                    </HBox>

                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
