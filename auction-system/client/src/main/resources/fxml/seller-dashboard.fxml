<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.SellerDashboardController"
            prefWidth="1100" prefHeight="680"
            style="-fx-background-color: #F5F7FA;">

    <!-- ── TOP NAV ─────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" prefHeight="56"
              style="-fx-background-color: #1565C0; -fx-padding: 0 24;">
            <Label text="AuctionSystem"
                   style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:white;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="SELLER DASHBOARD"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#90CAF9;"/>
            <Separator orientation="VERTICAL" style="-fx-opacity:0.4;"/>
            <Button text="← Thoát" onAction="#handleBack"
                    style="-fx-background-color:#0D47A1;-fx-text-fill:white;-fx-cursor:hand;
                           -fx-background-radius:6;-fx-font-size:12px;-fx-padding:6 14;"/>
        </HBox>
    </top>

    <!-- ── MAIN CONTENT ──────────────────────────────── -->
    <center>
        <HBox spacing="16" style="-fx-padding:16;">

            <!-- ── LEFT: Danh sách phiên đấu giá ── -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" minWidth="480">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Phiên đấu giá của tôi"
                           style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1A237E;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="＋ Tạo mới" onAction="#handleNew"
                            style="-fx-background-color:#1565C0;-fx-text-fill:white;
                                   -fx-background-radius:6;-fx-cursor:hand;-fx-font-size:12px;
                                   -fx-padding:6 14;"/>
                    <Button fx:id="btnEdit" text="✏ Sửa" onAction="#handleEdit" disable="true"
                            style="-fx-background-color:#F57C00;-fx-text-fill:white;
                                   -fx-background-radius:6;-fx-cursor:hand;-fx-font-size:12px;
                                   -fx-padding:6 14;"/>
                    <Button fx:id="btnDelete" text="✕ Xóa" onAction="#handleDelete" disable="true"
                            style="-fx-background-color:#C62828;-fx-text-fill:white;
                                   -fx-background-radius:6;-fx-cursor:hand;-fx-font-size:12px;
                                   -fx-padding:6 14;"/>
                </HBox>

                <TableView fx:id="tblMyAuctions" VBox.vgrow="ALWAYS"
                           onMouseClicked="#handleSelectAuction"
                           style="-fx-background-radius:8;-fx-border-radius:8;
                                  -fx-border-color:#E0E0E0;-fx-border-width:1;">
                    <columns>
                        <TableColumn fx:id="colMyName"   text="Tên sản phẩm"  prefWidth="210"/>
                        <TableColumn fx:id="colMyPrice"  text="Giá hiện tại"  prefWidth="130"/>
                        <TableColumn fx:id="colMyStatus" text="Trạng thái"    prefWidth="120"/>
                        <TableColumn fx:id="colMyBids"   text="Số lượt bid"   prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Bạn chưa có phiên đấu giá nào."
                               style="-fx-text-fill:#9E9E9E;-fx-font-size:13px;"/>
                    </placeholder>
                </TableView>

                <Label text="💡 Nhấp đúp vào phiên để điền thông tin vào form sửa."
                       style="-fx-font-size:11px;-fx-text-fill:#757575;"/>
            </VBox>

            <!-- ── RIGHT: Form tạo / sửa ── -->
            <VBox spacing="12" prefWidth="380"
                  style="-fx-background-color:white;-fx-background-radius:10;
                         -fx-border-color:#E0E0E0;-fx-border-radius:10;
                         -fx-border-width:1;-fx-padding:20;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);">

                <Label fx:id="lblFormTitle" text="Tạo phiên đấu giá mới"
                       style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1A237E;"/>
                <Separator/>

                <!-- Tên sản phẩm -->
                <VBox spacing="4">
                    <Label text="Tên sản phẩm *"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#424242;"/>
                    <TextField fx:id="txtName" promptText="Nhập tên sản phẩm..."
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#BDBDBD;-fx-border-width:1;
                                      -fx-padding:8;-fx-font-size:13px;"/>
                </VBox>

                <!-- Mô tả -->
                <VBox spacing="4">
                    <Label text="Mô tả"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#424242;"/>
                    <TextArea fx:id="txtDesc" promptText="Mô tả sản phẩm..."
                              prefRowCount="3" wrapText="true"
                              style="-fx-background-radius:6;-fx-border-radius:6;
                                     -fx-border-color:#BDBDBD;-fx-border-width:1;
                                     -fx-font-size:13px;"/>
                </VBox>

                <!-- Giá và mức tăng -->
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Giá khởi điểm (₫) *"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#424242;"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Mức tăng tối thiểu (₫) *"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#424242;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <TextField fx:id="txtStartPrice" promptText="VD: 1000000"
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#BDBDBD;-fx-border-width:1;
                                      -fx-padding:8;-fx-font-size:13px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtIncrement" promptText="VD: 100000"
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#BDBDBD;-fx-border-width:1;
                                      -fx-padding:8;-fx-font-size:13px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>

                <!-- Thời gian -->
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Thời gian bắt đầu *"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#424242;"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Thời gian kết thúc *"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#424242;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <TextField fx:id="txtStartTime" promptText="yyyy-MM-ddTHH:mm"
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#BDBDBD;-fx-border-width:1;
                                      -fx-padding:8;-fx-font-size:12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtEndTime" promptText="yyyy-MM-ddTHH:mm"
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#BDBDBD;-fx-border-width:1;
                                      -fx-padding:8;-fx-font-size:12px;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>

                <Label text="Định dạng: 2025-12-31T14:30 (năm-tháng-ngàyTgiờ:phút)"
                       style="-fx-font-size:10px;-fx-text-fill:#9E9E9E;"/>

                <!-- URL hình ảnh -->
                <VBox spacing="4">
                    <Label text="URL hình ảnh (tùy chọn)"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#424242;"/>
                    <TextField fx:id="txtImageUrl" promptText="https://..."
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#BDBDBD;-fx-border-width:1;
                                      -fx-padding:8;-fx-font-size:13px;"/>
                </VBox>

                <!-- Thông báo lỗi / thành công -->
                <Label fx:id="lblFormMsg" wrapText="true" visible="false" managed="false"
                       style="-fx-font-size:12px;"/>

                <Pane VBox.vgrow="ALWAYS"/>

                <!-- Nút hành động -->
                <HBox spacing="10">
                    <Button fx:id="btnSave" text="Tạo phiên" onAction="#handleSave"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color:#1565C0;-fx-text-fill:white;
                                   -fx-background-radius:8;-fx-cursor:hand;
                                   -fx-font-size:13px;-fx-font-weight:bold;
                                   -fx-padding:10 0;"/>
                    <Button text="Xóa form" onAction="#handleClearForm"
                            style="-fx-background-color:#ECEFF1;-fx-text-fill:#546E7A;
                                   -fx-background-radius:8;-fx-cursor:hand;
                                   -fx-font-size:13px;-fx-padding:10 14;"/>
                </HBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
