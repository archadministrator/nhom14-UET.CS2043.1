<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.SellerDashboardController"
            prefWidth="1100" prefHeight="680"
            styleClass="app-shell"
            stylesheets="@../css/main.css">

    <!-- ── TOP NAV ──────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-nav">
            <Label text="⬡ AUCTION" styleClass="nav-brand"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="SELLER DASHBOARD"
                   styleClass="role-badge"
                   style="-fx-text-fill: #F59B23; -fx-border-color: #F59B23;
                          -fx-background-color: rgba(245,155,35,0.10);"/>
            <Separator orientation="VERTICAL" style="-fx-opacity: 0.2; -fx-padding: 0 4;"/>
            <Button text="← Thoát" onAction="#handleBack"
                    styleClass="button, btn-secondary"
                    style="-fx-padding: 8 18; -fx-font-size: 12px;"/>
        </HBox>
    </top>

    <!-- ── MAIN CONTENT ─────────────────────────────────── -->
    <center>
        <HBox spacing="16" style="-fx-padding: 16; -fx-background-color: #121212;">

            <!-- ─ LEFT: My auction list ──────────────────── -->
            <VBox spacing="12" HBox.hgrow="ALWAYS" minWidth="480">

                <!-- Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar"
                      style="-fx-background-radius: 10 10 0 0; -fx-border-radius: 10 10 0 0;
                             -fx-border-color: transparent; -fx-padding: 14 20;">
                    <Label text="PHIÊN ĐẤU GIÁ CỦA TÔI"
                           styleClass="sidebar-section-label"
                           style="-fx-padding: 0; -fx-font-size: 11px;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="＋ Tạo mới" onAction="#handleNew"
                            styleClass="button, btn-primary"
                            style="-fx-padding: 7 16; -fx-font-size: 12px;"/>
                    <Button fx:id="btnEdit" text="✏ Sửa" onAction="#handleEdit" disable="true"
                            styleClass="button, btn-warn"
                            style="-fx-padding: 7 16; -fx-font-size: 12px;"/>
                    <Button fx:id="btnDelete" text="✕ Xóa" onAction="#handleDelete" disable="true"
                            styleClass="button, btn-danger"
                            style="-fx-padding: 7 16; -fx-font-size: 12px;"/>
                </HBox>

                <TableView fx:id="tblMyAuctions" VBox.vgrow="ALWAYS"
                           onMouseClicked="#handleSelectAuction"
                           style="-fx-background-color: #181818;
                                  -fx-background-radius: 0 0 10 10;
                                  -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colMyName"   text="TÊN SẢN PHẨM"  prefWidth="230"/>
                        <TableColumn fx:id="colMyPrice"  text="GIÁ HIỆN TẠI"  prefWidth="140"/>
                        <TableColumn fx:id="colMyStatus" text="TRẠNG THÁI"     prefWidth="130"/>
                        <TableColumn fx:id="colMyBids"   text="SỐ LƯỢT BID"   prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="Bạn chưa có phiên đấu giá nào."
                               styleClass="label-muted"
                               style="-fx-font-size: 13px;"/>
                    </placeholder>
                </TableView>

                <Label text="💡  Nhấp đúp vào phiên để chỉnh sửa"
                       styleClass="hint-label"/>
            </VBox>

            <!-- ─ RIGHT: Create / Edit form ──────────────── -->
            <VBox spacing="16" prefWidth="390" styleClass="card-elevated">

                <Label fx:id="lblFormTitle" text="Tạo phiên đấu giá mới"
                       styleClass="section-title"
                       style="-fx-font-size: 16px;"/>

                <Separator/>

                <!-- Tên sản phẩm -->
                <VBox spacing="6">
                    <Label text="TÊN SẢN PHẨM *" styleClass="field-label"/>
                    <TextField fx:id="txtName" promptText="Nhập tên sản phẩm..."/>
                </VBox>

                <!-- Mô tả -->
                <VBox spacing="6">
                    <Label text="MÔ TẢ" styleClass="field-label"/>
                    <TextArea fx:id="txtDesc" promptText="Mô tả sản phẩm..."
                              prefRowCount="3" wrapText="true"/>
                </VBox>

                <!-- Giá & mức tăng -->
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="GIÁ KHỞI ĐIỂM (₫) *" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="MỨC TĂNG TỐI THIỂU (₫) *" styleClass="field-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <TextField fx:id="txtStartPrice" promptText="VD: 1000000"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtIncrement" promptText="VD: 100000"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>

                <!-- Thời gian -->
                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="THỜI GIAN BẮT ĐẦU *" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="THỜI GIAN KẾT THÚC *" styleClass="field-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <TextField fx:id="txtStartTime" promptText="yyyy-MM-ddTHH:mm"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtEndTime" promptText="yyyy-MM-ddTHH:mm"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>

                <Label text="Định dạng: 2025-12-31T14:30"
                       styleClass="hint-label"/>

                <!-- URL hình ảnh -->
                <VBox spacing="6">
                    <Label text="URL HÌNH ẢNH (tùy chọn)" styleClass="field-label"/>
                    <TextField fx:id="txtImageUrl" promptText="https://..."/>
                </VBox>

                <!-- Status message -->
                <Label fx:id="lblFormMsg" wrapText="true" visible="false" managed="false"
                       style="-fx-font-size: 12px;"/>

                <Pane VBox.vgrow="ALWAYS"/>

                <!-- Action buttons -->
                <HBox spacing="10">
                    <Button fx:id="btnSave" text="Tạo phiên" onAction="#handleSave"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            styleClass="button, btn-primary"
                            style="-fx-font-size: 13px; -fx-padding: 12 0; -fx-background-radius: 8;"/>
                    <Button text="Xóa form" onAction="#handleClearForm"
                            styleClass="button, btn-secondary"
                            style="-fx-font-size: 13px; -fx-padding: 12 18; -fx-background-radius: 8;"/>
                </HBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
