<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionListController"
            prefWidth="1100"
            prefHeight="680"
            style="-fx-background-color: #F5F7FA;">

    <!-- ── TOP NAV ─────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="14"
              prefHeight="56"
              style="-fx-background-color: #1565C0; -fx-padding: 0 24;">

            <Label text="AuctionSystem"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblRole"
                   style="-fx-font-size: 11px; -fx-text-fill: #90CAF9;
                          -fx-padding: 3 10; -fx-border-color: #42A5F5;
                          -fx-border-radius: 10; -fx-border-width: 1;"/>

            <Label fx:id="lblUsername"
                   style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <Label fx:id="lblBalance"
                   style="-fx-font-size: 13px; -fx-text-fill: #A5D6A7;"/>

            <Button fx:id="btnTopUp"
                    text="Nạp tiền"
                    onAction="#handleTopUp"
                    style="-fx-background-color: #43A047; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-background-radius: 4;
                           -fx-cursor: hand; -fx-padding: 5 12;"/>

            <Button text="Đăng xuất"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #EF9A9A;
                           -fx-border-color: #EF9A9A; -fx-border-radius: 4;
                           -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 5 12;"/>
        </HBox>
    </top>

    <!-- ── LEFT SIDEBAR ───────────────────────────── -->
    <left>
        <VBox prefWidth="185"
              spacing="2"
              style="-fx-background-color: white;
                     -fx-border-color: transparent #E0E0E0 transparent transparent;
                     -fx-border-width: 0 1 0 0; -fx-padding: 12 0;">

            <Label text="MENU"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #9E9E9E; -fx-padding: 10 20 6 20;
                          -fx-letter-spacing: 0.06em;"/>

            <Button fx:id="btnMenuAll"
                    text="Tất cả phiên"
                    onAction="#filterAll"
                    maxWidth="Infinity"
                    style="-fx-background-color: #E3F2FD; -fx-text-fill: #1565C0;
                           -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 20; -fx-border-color: transparent;
                           -fx-cursor: hand;"/>

            <Button text="Đang diễn ra"
                    onAction="#filterRunning"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #424242;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;
                           -fx-border-color: transparent; -fx-cursor: hand;"/>

            <Button text="Sắp diễn ra"
                    onAction="#filterOpen"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #424242;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;
                           -fx-border-color: transparent; -fx-cursor: hand;"/>

            <Button text="Đã kết thúc"
                    onAction="#filterFinished"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #424242;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;
                           -fx-border-color: transparent; -fx-cursor: hand;"/>

            <Separator style="-fx-padding: 6 14;"/>

            <Button fx:id="btnMySales"
                    text="Sản phẩm của tôi"
                    onAction="#showMySales"
                    maxWidth="Infinity"
                    visible="false"
                    managed="false"
                    style="-fx-background-color: transparent; -fx-text-fill: #424242;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;
                           -fx-border-color: transparent; -fx-cursor: hand;"/>

            <Button fx:id="btnNewAuction"
                    text="+ Tạo phiên mới"
                    onAction="#handleCreateAuction"
                    maxWidth="Infinity"
                    visible="false"
                    managed="false"
                    style="-fx-background-color: #1B5E20; -fx-text-fill: white;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;
                           -fx-border-color: transparent; -fx-cursor: hand;"/>

            <Button text="Lịch sử bid"
                    onAction="#showMyBids"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #424242;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;
                           -fx-border-color: transparent; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ── CENTER ─────────────────────────────────── -->
    <center>
        <VBox>

            <!-- Toolbar -->
            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  style="-fx-background-color: white; -fx-padding: 12 20;
                         -fx-border-color: transparent transparent #E0E0E0 transparent;
                         -fx-border-width: 0 0 1 0;">

                <Label fx:id="lblPageTitle"
                       text="Tất cả phiên đấu giá"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <TextField fx:id="txtSearch"
                           promptText="Tìm kiếm sản phẩm..."
                           prefWidth="220"/>

                <Button text="Tìm"
                        onAction="#handleSearch"
                        style="-fx-background-color: #1565C0; -fx-text-fill: white;
                               -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 7 14;"/>

                <Button text="↻ Làm mới"
                        onAction="#handleRefresh"
                        style="-fx-background-color: transparent; -fx-text-fill: #1565C0;
                               -fx-border-color: #1565C0; -fx-border-radius: 6;
                               -fx-cursor: hand; -fx-padding: 7 12;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblAuctions"
                       VBox.vgrow="ALWAYS"
                       onMouseClicked="#handleRowDoubleClick"
                       style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <columns>
                    <TableColumn fx:id="colId"      text="ID"           prefWidth="55"/>
                    <TableColumn fx:id="colName"    text="Sản phẩm"     prefWidth="280"/>
                    <TableColumn fx:id="colPrice"   text="Giá hiện tại" prefWidth="140"/>
                    <TableColumn fx:id="colBids"    text="Bid"          prefWidth="70"/>
                    <TableColumn fx:id="colStatus"  text="Trạng thái"   prefWidth="130"/>
                    <TableColumn fx:id="colEndTime" text="Kết thúc"     prefWidth="150"/>
                    <TableColumn fx:id="colSeller"  text="Người bán"    prefWidth="110"/>
                </columns>
                <placeholder>
                    <Label text="Không có phiên nào"
                           style="-fx-text-fill: #9E9E9E;"/>
                </placeholder>
            </TableView>

            <!-- Status bar -->
            <HBox alignment="CENTER_LEFT"
                  spacing="16"
                  style="-fx-background-color: #ECEFF1; -fx-padding: 6 20;">
                <Label fx:id="lblCount"
                       text="0 phiên"
                       style="-fx-font-size: 12px; -fx-text-fill: #607D8B;"/>
                <Label fx:id="lblStatus"
                       text=""
                       style="-fx-font-size: 12px; -fx-text-fill: #43A047;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblWsStatus"
                       text="● Đang kết nối..."
                       style="-fx-font-size: 11px; -fx-text-fill: #FF9800;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
