<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.LoginController"
      alignment="CENTER"
      spacing="0"
      prefWidth="420"
      prefHeight="560"
      style="-fx-background-color: #F5F7FA;">

    <!-- Header -->
    <VBox alignment="CENTER"
          spacing="6"
          style="-fx-background-color: #1565C0; -fx-padding: 32 0 28 0;">
        <Label text="AuctionSystem"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Hệ thống đấu giá trực tuyến"
               style="-fx-font-size: 13px; -fx-text-fill: #90CAF9;"/>
    </VBox>

    <!-- Tab bar -->
    <HBox style="-fx-background-color: #1976D2;">
        <Button fx:id="btnTabLogin"
                text="Đăng nhập"
                onAction="#switchToLogin"
                maxWidth="Infinity"
                prefHeight="40"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color: white; -fx-text-fill: #1565C0;
                       -fx-font-weight: bold; -fx-font-size: 13px;
                       -fx-border-color: transparent; -fx-cursor: hand;"/>
        <Button fx:id="btnTabRegister"
                text="Đăng ký"
                onAction="#switchToRegister"
                maxWidth="Infinity"
                prefHeight="40"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-text-fill: #BBDEFB;
                       -fx-font-size: 13px; -fx-border-color: transparent; -fx-cursor: hand;"/>
    </HBox>

    <!-- Form card -->
    <VBox spacing="14"
          style="-fx-background-color: white; -fx-padding: 28 36 28 36;">

        <!-- LOGIN FIELDS -->
        <VBox fx:id="loginFields" spacing="12">
            <VBox spacing="5">
                <Label text="Tên đăng nhập"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <TextField fx:id="txtUsername"
                           promptText="Nhập username"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Mật khẩu"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <PasswordField fx:id="txtPassword"
                               promptText="Nhập mật khẩu"/>
            </VBox>
        </VBox>

        <!-- REGISTER FIELDS (ẩn mặc định) -->
        <VBox fx:id="registerFields" spacing="12" visible="false" managed="false">
            <VBox spacing="5">
                <Label text="Tên đăng nhập"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <TextField fx:id="txtRegUsername"
                           promptText="Tối thiểu 3 ký tự"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Email"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <TextField fx:id="txtEmail"
                           promptText="example@email.com"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Mật khẩu"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <PasswordField fx:id="txtRegPassword"
                               promptText="Tối thiểu 6 ký tự"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Vai trò"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <ComboBox fx:id="cmbRole" maxWidth="Infinity"/>
            </VBox>
        </VBox>

        <!-- Error message -->
        <Label fx:id="lblError"
               text=""
               wrapText="true"
               visible="false"
               managed="false"
               style="-fx-text-fill: #C62828; -fx-font-size: 12px;"/>

        <!-- Submit button -->
        <Button fx:id="btnSubmit"
                text="Đăng nhập"
                onAction="#handleSubmit"
                maxWidth="Infinity"
                prefHeight="42"
                style="-fx-background-color: #1565C0; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 6; -fx-cursor: hand;"/>

    </VBox>

</VBox>
