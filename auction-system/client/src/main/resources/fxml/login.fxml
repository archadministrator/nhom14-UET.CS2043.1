<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.LoginController"
           styleClass="login-screen"
           stylesheets="@../css/main.css">

    <Pane styleClass="login-screen"/>

    <!-- Centered card -->
    <VBox alignment="CENTER" spacing="0" maxWidth="400" maxHeight="560">

        <!-- Brand header -->
        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 28 0;">
            <Label text="⬡ AUCTION" styleClass="nav-brand"
                   style="-fx-font-size: 28px; -fx-letter-spacing: 0.06em;"/>
            <Label text="Hệ thống đấu giá trực tuyến"
                   styleClass="label-muted"
                   style="-fx-font-size: 13px;"/>
        </VBox>

        <!-- Card -->
        <VBox styleClass="login-card" spacing="0">

            <!-- Tab switcher -->
            <HBox style="-fx-background-color: #121212; -fx-background-radius: 6 6 0 0;
                         -fx-border-color: #333333; -fx-border-width: 0 0 1 0;
                         -fx-margin: 0 0 20 0;">
                <Button fx:id="btnTabLogin"
                        text="Đăng nhập"
                        onAction="#switchToLogin"
                        maxWidth="Infinity"
                        prefHeight="44"
                        HBox.hgrow="ALWAYS"
                        styleClass="tab-btn-active"/>
                <Button fx:id="btnTabRegister"
                        text="Đăng ký"
                        onAction="#switchToRegister"
                        maxWidth="Infinity"
                        prefHeight="44"
                        HBox.hgrow="ALWAYS"
                        styleClass="tab-btn-inactive"/>
            </HBox>

            <!-- Form area -->
            <VBox spacing="20" style="-fx-padding: 28 0 0 0;">

                <!-- LOGIN FIELDS -->
                <VBox fx:id="loginFields" spacing="16">
                    <VBox spacing="6">
                        <Label text="TÊN ĐĂNG NHẬP" styleClass="field-label"/>
                        <TextField fx:id="txtUsername" promptText="Nhập username"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="MẬT KHẨU" styleClass="field-label"/>
                        <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu"/>
                    </VBox>
                </VBox>

                <!-- REGISTER FIELDS  -->
                <VBox fx:id="registerFields" spacing="16" visible="false" managed="false">
                    <VBox spacing="6">
                        <Label text="TÊN ĐĂNG NHẬP" styleClass="field-label"/>
                        <TextField fx:id="txtRegUsername" promptText="Tối thiểu 3 ký tự"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="EMAIL" styleClass="field-label"/>
                        <TextField fx:id="txtEmail" promptText="example@email.com"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="MẬT KHẨU" styleClass="field-label"/>
                        <PasswordField fx:id="txtRegPassword" promptText="Tối thiểu 6 ký tự"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="VAI TRÒ" styleClass="field-label"/>
                        <ComboBox fx:id="cmbRole" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <!-- Error message -->
                <Label fx:id="lblError"
                       text=""
                       wrapText="true"
                       visible="false"
                       managed="false"
                       styleClass="label-danger"
                       style="-fx-font-size: 12px;"/>

                <!-- Submit button -->
                <Button fx:id="btnSubmit"
                        text="ĐĂNG NHẬP"
                        onAction="#handleSubmit"
                        maxWidth="Infinity"
                        prefHeight="48"
                        styleClass="button, btn-primary"
                        style="-fx-font-size: 14px; -fx-letter-spacing: 0.06em; -fx-background-radius: 500;"/>

            </VBox>

        </VBox>

    </VBox>
</StackPane>
