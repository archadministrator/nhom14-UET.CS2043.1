<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionDetailController"
            styleClass="app-shell"
            stylesheets="@../css/main.css">

    <!-- ── TOP NAV ──────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16"
              styleClass="top-nav">

            <Button text="← Quay lại"
                    onAction="#handleBack"
                    styleClass="btn-ghost"
                    style="-fx-font-size: 13px;"/>

            <Separator orientation="VERTICAL"
                       style="-fx-opacity: 0.3; -fx-padding: 0 4;"/>

            <Label fx:id="lblAuctionName"
                   text="Chi tiết phiên đấu giá"
                   styleClass="page-title"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- Status badge set dynamically -->
            <Label fx:id="lblStatusBadge"
                   styleClass="badge"/>

            <Label fx:id="lblCountdown"
                   styleClass="countdown-label"/>

        </HBox>
    </top>

    <!-- ── CENTER ───────────────────────────────────────── -->
    <center>
        <HBox spacing="16" style="-fx-padding: 16; -fx-background-color: #121212;">

            <!-- ─ LEFT COLUMN ─────────────────────────── -->
            <VBox spacing="12" prefWidth="360" minWidth="320">

                <!-- Product info card -->
                <VBox spacing="6" styleClass="card">
                    <Label fx:id="lblProductName"
                           text=""
                           wrapText="true"
                           styleClass="section-title"
                           style="-fx-font-size: 16px;"/>
                    <Label fx:id="lblDescription"
                           text=""
                           wrapText="true"
                           styleClass="label-secondary"/>

                    <Separator/>

                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="140"/>
                            <ColumnConstraints prefWidth="180"/>
                        </columnConstraints>

                        <Label text="Giá khởi điểm"
                               styleClass="label-muted"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblStartPrice"
                               text=""
                               styleClass="label"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Mức tăng tối thiểu"
                               styleClass="label-muted"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblMinIncrement"
                               text=""
                               styleClass="label-accent"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Người bán"
                               styleClass="label-muted"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblSeller"
                               text=""
                               styleClass="label"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Kết thúc lúc"
                               styleClass="label-muted"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lblEndTime"
                               text=""
                               styleClass="label"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- Live price card -->
                <VBox alignment="CENTER" spacing="4" styleClass="card-live">
                    <Label text="GIÁ HIỆN TẠI"
                           styleClass="label-muted"
                           style="-fx-letter-spacing: 0.1em; -fx-font-size: 11px;"/>
                    <Label fx:id="lblCurrentPrice"
                           text="—"
                           styleClass="price-big"/>
                    <Label fx:id="lblLeader"
                           text=""
                           styleClass="label-accent"
                           style="-fx-font-size: 12px;"/>
                    <Label fx:id="lblTotalBids"
                           text="0 lượt đặt"
                           styleClass="label-muted"/>
                </VBox>

                <!-- Bid panel (BIDDER + RUNNING only) -->
                <VBox fx:id="bidPanel" spacing="6" styleClass="card">
                    <Label text="ĐẶT GIÁ" styleClass="section-title"
                           style="-fx-letter-spacing: 0.06em;"/>

                    <VBox spacing="6">
                        <Label text="SỐ TIỀN (₫)" styleClass="field-label"/>
                        <TextField fx:id="txtBidAmount" promptText="Nhập số tiền..."/>
                    </VBox>

                    <Button fx:id="btnBid"
                            text="ĐẶT GIÁ NGAY"
                            onAction="#handlePlaceBid"
                            maxWidth="Infinity"
                            prefHeight="30"
                            styleClass="button, btn-primary"
                            style="-fx-font-size: 14px; -fx-letter-spacing: 0.04em;"/>

                    <Separator/>

                    <Label text="AUTO-BID" styleClass="section-title"
                           style="-fx-font-size: 12px; -fx-letter-spacing: 0.08em;"/>

                    <VBox spacing="4">
                        <Label text="GIÁ TỐI ĐA (₫)" styleClass="field-label"/>
                        <TextField fx:id="txtAutoMax" promptText="Nhập giá tối đa..."/>
                    </VBox>

                    <HBox spacing="6">
                        <Button text="Bật Auto-Bid"
                                onAction="#handleAutoBidOn"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                styleClass="button, btn-primary"
                                style="-fx-padding: 8 0; -fx-font-size: 12px;"/>
                        <Button text="Tắt"
                                onAction="#handleAutoBidOff"
                                styleClass="button, btn-danger"
                                style="-fx-padding: 8 18; -fx-font-size: 12px;"/>
                    </HBox>

                    <Label fx:id="lblBidMsg"
                           text=""
                           wrapText="true"
                           style="-fx-font-size: 12px;"/>
                </VBox>

                <!-- Winner panel (shown when FINISHED) -->
                <VBox fx:id="winnerPanel"
                      alignment="CENTER"
                      spacing="8"
                      visible="false"
                      managed="false"
                      styleClass="card-winner">
                    <Label text="🏆  NGƯỜI THẮNG CUỘC"
                           styleClass="label-warn"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 0.08em;"/>
                    <Label fx:id="lblWinner"
                           text="—"
                           styleClass="label"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>

            </VBox>

            <!-- ─ RIGHT COLUMN ────────────────────────── -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <!-- Price chart -->
                <VBox prefHeight="180" styleClass="card">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                        <Label text="LỊCH SỬ GIÁ"
                               styleClass="sidebar-section-label"
                               style="-fx-padding: 0; -fx-font-size: 11px;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="↻"
                                onAction="#refreshBidHistory"
                                styleClass="btn-icon"/>
                    </HBox>
                    <LineChart fx:id="priceChart"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-padding: 0;">
                        <xAxis>
                            <NumberAxis fx:id="xAxis" label="Lượt bid" side="BOTTOM"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" label="Giá" side="LEFT"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <!-- Bid history table -->
                <VBox VBox.vgrow="ALWAYS" styleClass="card">
                    <HBox alignment="CENTER_LEFT"
                          spacing="12"
                          style="-fx-padding: 0 0 12 0;">
                        <Label text="LỊCH SỬ ĐẶT GIÁ"
                               styleClass="sidebar-section-label"
                               style="-fx-padding: 0; -fx-font-size: 11px;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <TableView fx:id="tblBids"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colBidTime"   text="THỜI GIAN" prefWidth="155"/>
                            <TableColumn fx:id="colBidder"    text="NGƯỜI ĐẶT" prefWidth="150"/>
                            <TableColumn fx:id="colBidAmount" text="SỐ TIỀN"   prefWidth="160"/>
                            <TableColumn fx:id="colBidAuto"   text="AUTO"      prefWidth="65"/>
                        </columns>
                        <placeholder>
                            <Label text="Chưa có lượt đặt nào"
                                   styleClass="label-muted"
                                   style="-fx-font-size: 13px;"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
