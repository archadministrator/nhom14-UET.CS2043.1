<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionDetailController"
            prefWidth="1100"
            prefHeight="700"
            style="-fx-background-color: #F5F7FA;">

    <!-- ── TOP NAV ─────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="16"
              prefHeight="52"
              style="-fx-background-color: #1565C0; -fx-padding: 0 24;">

            <Button text="← Quay lại"
                    onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #90CAF9;
                           -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 13px;"/>

            <Label fx:id="lblAuctionName"
                   text="Chi tiết phiên đấu giá"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblStatusBadge"
                   style="-fx-font-size: 12px; -fx-text-fill: white; -fx-padding: 4 12;
                          -fx-background-radius: 12;"/>

            <Label fx:id="lblCountdown"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FFD54F;"/>
        </HBox>
    </top>

    <!-- ── CENTER ─────────────────────────────────── -->
    <center>
        <HBox spacing="16" style="-fx-padding: 16;">

            <!-- LEFT COLUMN -->
            <VBox spacing="12" prefWidth="370" minWidth="340">

                <!-- Product info card -->
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-padding: 18;
                             -fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #E0E0E0; -fx-border-width: 1;">
                    <Label fx:id="lblProductName"
                           text=""
                           wrapText="true"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblDescription"
                           text=""
                           wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: #616161;"/>
                    <Separator/>
                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="130"/>
                            <ColumnConstraints prefWidth="200"/>
                        </columnConstraints>
                        <Label text="Giá khởi điểm:"
                               style="-fx-text-fill: #9E9E9E; -fx-font-size: 12px;"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblStartPrice"
                               text=""
                               style="-fx-font-weight: bold; -fx-font-size: 12px;"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Mức tăng tối thiểu:"
                               style="-fx-text-fill: #9E9E9E; -fx-font-size: 12px;"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblMinIncrement"
                               text=""
                               style="-fx-font-size: 12px;"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Người bán:"
                               style="-fx-text-fill: #9E9E9E; -fx-font-size: 12px;"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblSeller"
                               text=""
                               style="-fx-font-size: 12px;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Kết thúc lúc:"
                               style="-fx-text-fill: #9E9E9E; -fx-font-size: 12px;"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lblEndTime"
                               text=""
                               style="-fx-font-size: 12px;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- Live price card -->
                <VBox alignment="CENTER"
                      spacing="6"
                      style="-fx-background-color: #E3F2FD; -fx-padding: 18;
                             -fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #90CAF9; -fx-border-width: 1;">
                    <Label text="Giá hiện tại"
                           style="-fx-font-size: 12px; -fx-text-fill: #1565C0;"/>
                    <Label fx:id="lblCurrentPrice"
                           text="—"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0D47A1;"/>
                    <Label fx:id="lblLeader"
                           text=""
                           style="-fx-font-size: 12px; -fx-text-fill: #1976D2;"/>
                    <Label fx:id="lblTotalBids"
                           text="0 lượt đặt"
                           style="-fx-font-size: 12px; -fx-text-fill: #607D8B;"/>
                </VBox>

                <!-- Bid panel (BIDDER + RUNNING only) -->
                <VBox fx:id="bidPanel"
                      spacing="12"
                      style="-fx-background-color: white; -fx-padding: 18;
                             -fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #E0E0E0; -fx-border-width: 1;">
                    <Label text="Đặt giá"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtBidAmount"
                                   promptText="Nhập số tiền..."
                                   HBox.hgrow="ALWAYS"/>
                        <Label text="₫"
                               style="-fx-font-size: 14px; -fx-text-fill: #9E9E9E;"/>
                    </HBox>
                    <Button fx:id="btnBid"
                            text="Đặt giá ngay"
                            onAction="#handlePlaceBid"
                            maxWidth="Infinity"
                            prefHeight="40"
                            style="-fx-background-color: #1565C0; -fx-text-fill: white;
                                   -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Separator/>
                    <Label text="Auto-Bid"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Giá tối đa:"
                               style="-fx-font-size: 12px;"/>
                        <TextField fx:id="txtAutoMax"
                                   promptText="Nhập giá tối đa..."
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="Bật Auto-Bid"
                                onAction="#handleAutoBidOn"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                style="-fx-background-color: #43A047; -fx-text-fill: white;
                                       -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 0;"/>
                        <Button text="Tắt"
                                onAction="#handleAutoBidOff"
                                style="-fx-background-color: #E53935; -fx-text-fill: white;
                                       -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 16;"/>
                    </HBox>
                    <Label fx:id="lblBidMsg"
                           text=""
                           wrapText="true"
                           style="-fx-font-size: 12px;"/>
                </VBox>

                <!-- Winner panel (shown when FINISHED) -->
                <VBox fx:id="winnerPanel"
                      alignment="CENTER"
                      spacing="6"
                      visible="false"
                      managed="false"
                      style="-fx-background-color: #FFF8E1; -fx-padding: 16;
                             -fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #FFD54F; -fx-border-width: 1;">
                    <Label text="🏆 Người thắng cuộc"
                           style="-fx-font-size: 12px; -fx-text-fill: #F57F17;"/>
                    <Label fx:id="lblWinner"
                           text="—"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E65100;"/>
                </VBox>

            </VBox>

            <!-- RIGHT COLUMN -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <!-- Price chart -->
                <VBox prefHeight="250"
                      style="-fx-background-color: white; -fx-padding: 16;
                             -fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #E0E0E0; -fx-border-width: 1;">
                    <Label text="Biểu đồ lịch sử giá"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 0 8 0;"/>
                    <LineChart fx:id="priceChart"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-padding: 0;">
                        <xAxis>
                            <NumberAxis fx:id="xAxis" label="Lượt bid" side="BOTTOM"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" label="Giá" side="LEFT"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <!-- Bid history table -->
                <VBox VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 16;
                             -fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #E0E0E0; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT"
                          spacing="12"
                          style="-fx-padding: 0 0 10 0;">
                        <Label text="Lịch sử đặt giá"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="↻"
                                onAction="#refreshBidHistory"
                                style="-fx-background-color: transparent; -fx-cursor: hand;
                                       -fx-text-fill: #1565C0; -fx-font-size: 14px;
                                       -fx-border-color: transparent;"/>
                    </HBox>
                    <TableView fx:id="tblBids"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colBidTime"   text="Thời gian" prefWidth="150"/>
                            <TableColumn fx:id="colBidder"    text="Người đặt" prefWidth="140"/>
                            <TableColumn fx:id="colBidAmount" text="Số tiền"   prefWidth="150"/>
                            <TableColumn fx:id="colBidAuto"   text="Auto"      prefWidth="60"/>
                        </columns>
                        <placeholder>
                            <Label text="Chưa có lượt đặt nào"
                                   style="-fx-text-fill: #9E9E9E;"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
