<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/8.0.171" 
          xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auctionfx.controller.AuctionDetailController"
          stylesheets="@style.css" styleClass="root" style="-fx-background-color: transparent;">
    
    <VBox spacing="30" style="-fx-padding: 40;">
        <Button text="← Quay lại sàn đấu giá" onAction="#handleBack" 
                style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: #818cf8; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 10;"/>
        
        <HBox spacing="30">
            <!-- Thông tin sản phẩm -->
            <VBox spacing="20" HBox.hgrow="ALWAYS" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label fx:id="titleLabel" text="Tên Sản Phẩm" styleClass="header-label"/>
                    <Label fx:id="categoryLabel" text="ELECTRONICS" styleClass="status-badge, status-running" style="-fx-background-color: rgba(129, 140, 248, 0.1); -fx-text-fill: #818cf8;"/>
                </HBox>
                
                <Label fx:id="descriptionLabel" text="Mô tả chi tiết sản phẩm sẽ hiển thị ở đây..." wrapText="true" 
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 15; -fx-line-spacing: 5;"/>
                
                <Separator opacity="0.1"/>
                
                <HBox spacing="60">
                    <VBox spacing="8">
                        <Label text="GIÁ KHỞI ĐIỂM" style="-fx-text-fill: #475569; -fx-font-weight: 800; -fx-font-size: 11;"/>
                        <Label fx:id="startingPriceLabel" text="1,000,000 VND" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="GIÁ HIỆN TẠI" style="-fx-text-fill: #475569; -fx-font-weight: 800; -fx-font-size: 11;"/>
                        <Label fx:id="currentPriceLabel" text="1,500,000 VND" styleClass="price-tag" style="-fx-font-size: 28;"/>
                    </VBox>
                </HBox>
                
                <VBox spacing="8" style="-fx-background-color: rgba(239, 68, 68, 0.05); -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: rgba(239, 68, 68, 0.1); -fx-border-radius: 15;">
                    <Label text="THỜI GIAN CÒN LẠI" style="-fx-text-fill: #ef4444; -fx-font-weight: 800; -fx-font-size: 11;"/>
                    <Label fx:id="timerLabel" text="00:45:12" styleClass="timer-accent" style="-fx-font-size: 24;"/>
                </VBox>
            </VBox>
            
            <!-- Panel Đặt giá -->
            <VBox spacing="25" prefWidth="350" styleClass="card">
                <Label text="ĐẤU GIÁ NGAY" style="-fx-font-weight: 800; -fx-font-size: 18; -fx-text-fill: white;"/>
                
                <VBox spacing="10">
                    <Label text="Số tiền bạn muốn đặt (VND)"/>
                    <TextField fx:id="bidAmountField" promptText="VD: 2,000,000"/>
                    <Button text="GỬI MỨC GIÁ" onAction="#handlePlaceBid" maxWidth="Infinity" 
                            style="-fx-background-color: linear-gradient(to right, #059669, #10b981); -fx-font-size: 16;"/>
                </VBox>
                
                <Separator opacity="0.1" />
                
                <VBox spacing="15">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🤖 Đấu giá tự động" style="-fx-font-weight: bold; -fx-font-size: 15;"/>
                        <Tooltip text="Hệ thống sẽ tự động đặt giá cho bạn đến khi chạm mức tối đa này."/>
                    </HBox>
                    <Label text="Giá tối đa bạn sẵn sàng trả" style="-fx-text-fill: #64748b; -fx-font-size: 13;"/>
                    <TextField fx:id="maxBidField" promptText="VD: 5,000,000"/>
                    <Button text="KÍCH HOẠT PROXY BID" onAction="#handleAutoBid" maxWidth="Infinity" 
                            style="-fx-background-color: rgba(139, 92, 246, 0.1); -fx-text-fill: #a78bfa; -fx-border-color: #8b5cf6; -fx-border-radius: 12;"/>
                </VBox>
            </VBox>
        </HBox>
        
        <HBox spacing="30">
            <!-- Biểu đồ giá -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="20">
                <Label text="Biến Động Giá" style="-fx-font-weight: 800; -fx-font-size: 18;"/>
                <LineChart fx:id="priceChart" prefHeight="350" animated="true" style="-fx-create-symbols: true;">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" label="Thời gian" tickLabelFill="#64748b"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" label="Giá (VND)" tickLabelFill="#64748b"/>
                    </yAxis>
                </LineChart>
            </VBox>
            
            <!-- Lịch sử đặt giá -->
            <VBox styleClass="card" prefWidth="450" spacing="20">
                <Label text="Lịch Sử Đấu Giá" style="-fx-font-weight: 800; -fx-font-size: 18;"/>
                <TableView fx:id="bidHistoryTable" prefHeight="350" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="timeCol" text="Thời gian" prefWidth="130"/>
                        <TableColumn fx:id="bidderCol" text="Người đặt" prefWidth="140"/>
                        <TableColumn fx:id="amountCol" text="Số tiền" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>