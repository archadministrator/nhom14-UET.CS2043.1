<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.example.auctionfx.controller.LoginController"
           stylesheets="@style.css" styleClass="root">
    
    <VBox alignment="CENTER" spacing="30.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>
        
        <VBox alignment="CENTER" spacing="10">
             <Label text="AUCTION" styleClass="header-label" style="-fx-font-size: 40;"/>
             <Label text="Sàn đấu giá thời gian thực cao cấp" style="-fx-text-fill: #94a3b8; -fx-font-size: 14;"/>
        </VBox>

        <VBox styleClass="card" spacing="25" maxWidth="400">
            <VBox spacing="8">
                <Label text="Tên đăng nhập" style="-fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Nhập username..."/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Mật khẩu" style="-fx-font-weight: bold;"/>
                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="passwordField" promptText="Nhập password..."/>
                    <TextField fx:id="passwordTextField" promptText="Nhập password..." visible="false"/>
                    <Button fx:id="showPasswordButton" text="👁" onAction="#togglePasswordVisibility" 
                            style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand; -fx-font-size: 16;">
                        <padding>
                            <Insets right="10"/>
                        </padding>
                    </Button>
                </StackPane>
            </VBox>
            
            <VBox spacing="15">
                <Button text="ĐĂNG NHẬP" onAction="#handleLogin" maxWidth="Infinity" style="-fx-font-size: 16;"/>
                
                <HBox alignment="CENTER" spacing="8">
                    <Label text="Chưa có tài khoản?" style="-fx-text-fill: #94a3b8;"/>
                    <Hyperlink text="Đăng ký ngay" onAction="#handleGoToRegister" styleClass="hyperlink"/>
                </HBox>
            </VBox>
            
            <Label fx:id="errorLabel" textFill="#f87171" wrapText="true" alignment="CENTER" maxWidth="Infinity" 
                   style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        </VBox>
        
        <Label text="© 2026 Auction System Premium. All rights reserved." style="-fx-text-fill: #475569; -fx-font-size: 12;"/>
    </VBox>
</StackPane>