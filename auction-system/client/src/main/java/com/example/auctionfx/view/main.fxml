<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.auctionfx.controller.MainController"
            stylesheets="@style.css" styleClass="root">
    
    <left>
        <VBox spacing="5" prefWidth="240" styleClass="sidebar">
            <padding>
                <Insets top="30" right="0" bottom="30" left="0"/>
            </padding>
            
            <VBox alignment="CENTER" spacing="15">
                <padding>
                    <Insets bottom="40"/>
                </padding>
                <Circle radius="35" fill="#6366f1" />
                <Label fx:id="userNameLabel" text="User Name" style="-fx-font-weight: 800; -fx-font-size: 16;"/>
            </VBox>

            <Label text="KHÁM PHÁ" style="-fx-text-fill: #475569; -fx-font-size: 11; -fx-font-weight: 800;">
                <padding><Insets left="20" bottom="10"/></padding>
            </Label>
            
            <Label text="🏠  Tất cả phiên" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
            <Label text="📱  Điện tử" styleClass="nav-item" maxWidth="Infinity"/>
            <Label text="🎨  Nghệ thuật" styleClass="nav-item" maxWidth="Infinity"/>
            <Label text="🚗  Xe cộ" styleClass="nav-item" maxWidth="Infinity"/>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Separator opacity="0.1" />
            <VBox spacing="10" style="-fx-padding: 20;">
                <Button text="+ Tạo Phiên Mới" fx:id="createButton" maxWidth="Infinity" style="-fx-background-color: #059669;"/>
                <Button text="🚪 Đăng xuất" onAction="#handleLogout" maxWidth="Infinity" style="-fx-background-color: rgba(239, 68, 68, 0.1); -fx-text-fill: #ef4444;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="25">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Bảng Tin Đấu Giá" styleClass="header-label"/>
                    <Label text="Tham gia các phiên đấu giá thời gian thực hấp dẫn nhất" style="-fx-text-fill: #94a3b8;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <TextField fx:id="searchField" promptText="Tìm kiếm sản phẩm..." prefWidth="300" 
                               style="-fx-background-color: rgba(255,255,255,0.05);"/>
                    <Button text="Tìm kiếm" style="-fx-padding: 10 20;"/>
                </HBox>
            </HBox>
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <FlowPane fx:id="auctionContainer" hgap="20" vgap="20">
                    <!-- Cards will be added here dynamically -->
                </FlowPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>